---
import '../styles/theme.css';
import Report, { frontmatter } from '../content/personal-info-generative-ai.mdx';

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const pdfHref = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/downloads/pii-genai-guide.pdf`;
const deckHref = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/deck/`;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#17233A" />
    <meta name="format-detection" content="telephone=no" />

    <title>{frontmatter.title}</title>
    <meta name="description" content={frontmatter.description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%2317233A'/%3E%3Ctext x='50' y='68' font-size='56' text-anchor='middle' fill='%23E4ECF7'%3E%F0%9F%94%90%3C/text%3E%3C/svg%3E"
    />

    <meta property="og:type" content="article" />
    <meta property="og:title" content={frontmatter.title} />
    <meta property="og:description" content={frontmatter.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700;900&family=JetBrains+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="guide-pdf-page min-h-screen">
    <header class="border-b border-guide-divider">
      <div class="mx-auto max-w-4xl px-6 py-12 md:py-16">
        <span class="gp-label block text-xs font-bold uppercase">AIガバナンス実務資料</span>
        <h1 class="mt-3 text-3xl font-black leading-tight md:text-5xl">{frontmatter.title}</h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-guide-ink-muted">{frontmatter.description}</p>

        <div class="mt-5 flex flex-wrap items-center gap-2">
          <span class="gp-badge">最終確認 {frontmatter.lastUpdated}</span>
          <span class="gp-badge">一次情報ベース・出典14件</span>
          <span class="gp-badge">対象：個人情報を扱う全ての組織</span>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-2">
          <a href={pdfHref} download="個人情報-生成AI-実務ガイド.pdf" class="gp-download-button">
            📄 PDF版をダウンロード（A4横・16ページ）
          </a>
          <a href={deckHref} class="gp-print-link" style="text-decoration:none;">
            PDFと同じレイアウトで読む ↗
          </a>
          <button type="button" class="gp-print-link" onclick="window.print()">
            🖨 このページを印刷
          </button>
        </div>

        <div class="mt-6 gp-keypoints">
          <p class="gp-keypoints-title">この資料でわかること</p>
          <ul class="gp-keypoints-list">
            {frontmatter.keyPoints.map((point: string) => <li>{point}</li>)}
          </ul>
        </div>

        <p class="mt-5 max-w-2xl text-xs leading-relaxed text-guide-ink-muted">
          対象読者：{frontmatter.audience}。特定のベンダーやサービスの宣伝を目的としたものではありません。本文中の番号「[n]」は巻末「出典一覧」の番号に対応します。
        </p>
      </div>
    </header>

    <main class="mx-auto max-w-4xl px-6 py-10 md:py-14">
      <article class="gp-article">
        <Report />
      </article>
    </main>

    <footer class="border-t border-guide-divider">
      <div class="mx-auto max-w-4xl px-6 py-8 text-xs leading-relaxed text-guide-ink-muted">
        {frontmatter.title} ／ 最終更新 {frontmatter.lastUpdated}
      </div>
    </footer>
  </body>
</html>
