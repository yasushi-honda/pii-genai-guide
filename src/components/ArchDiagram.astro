---
interface Branch {
  edgeLabel: string;
  title: string;
  subtitle: string;
  highlight?: boolean;
}

interface Props {
  entryLabel: string;
  hubTitle: string;
  hubSubtitle: string;
  branches: Branch[];
}

const { entryLabel, hubTitle, hubSubtitle, branches } = Astro.props;
---

<div class="gp-arch-diagram">
  <div class="gp-arch-entry gp-card">
    <p class="m-0 text-sm font-bold text-guide-ink">{entryLabel}</p>
  </div>

  <span class="gp-arch-arrow gp-arch-arrow-vertical" aria-hidden="true">↓</span>

  <div class="gp-arch-hub gp-card">
    <p class="m-0 text-sm font-bold text-guide-accent">{hubTitle}</p>
    <p class="m-0 mt-1 text-xs text-guide-ink-muted">{hubSubtitle}</p>
  </div>

  <div class="gp-arch-branches">
    {
      branches.map((b) => (
        <div class="gp-arch-branch">
          <span class="gp-arch-edge-label">{b.edgeLabel}</span>
          <span class="gp-arch-arrow" aria-hidden="true">↓</span>
          <div class={`gp-arch-branch-box gp-card ${b.highlight ? 'gp-arch-branch-highlight' : ''}`}>
            <p class="m-0 text-xs font-bold text-guide-ink">{b.title}</p>
            <p class="m-0 mt-1 text-[11px] text-guide-ink-muted">{b.subtitle}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>
