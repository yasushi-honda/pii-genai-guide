---
import { chapters } from '../data/chapters';
---

<div class="gp-progress-bar" aria-hidden="true">
  <div class="gp-progress-fill" id="gp-progress-fill"></div>
</div>

<div class="gp-mobile-nav">
  <label for="gp-chapter-jump" class="sr-only">章へジャンプ</label>
  <select id="gp-chapter-jump" class="gp-chapter-jump">
    <option value="">章を選択してジャンプ</option>
    {
      chapters.map((chapter) => (
        <option value={`#${chapter.id}`}>
          {chapter.num} {chapter.title}
        </option>
      ))
    }
  </select>
</div>

<button type="button" id="gp-back-to-top" class="gp-back-to-top" aria-label="トップへ戻る" hidden>
  ↑
</button>

<script>
  const fill = document.getElementById('gp-progress-fill');

  const updateProgress = () => {
    const doc = document.documentElement;
    const scrollTop = doc.scrollTop || document.body.scrollTop;
    const height = doc.scrollHeight - doc.clientHeight;
    const pct = height > 0 ? (scrollTop / height) * 100 : 0;
    if (fill) fill.style.width = `${pct}%`;
  };

  document.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
  updateProgress();

  const jump = document.getElementById('gp-chapter-jump') as HTMLSelectElement | null;
  jump?.addEventListener('change', () => {
    const value = jump.value;
    if (!value) return;
    document.querySelector(value)?.scrollIntoView({ behavior: 'smooth' });
    jump.value = '';
  });

  const backToTop = document.getElementById('gp-back-to-top');
  const updateBackToTop = () => {
    if (!backToTop) return;
    backToTop.hidden = window.scrollY < window.innerHeight;
  };
  document.addEventListener('scroll', updateBackToTop, { passive: true });
  updateBackToTop();
  backToTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
