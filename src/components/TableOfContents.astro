---
import { chapters } from '../data/chapters';
---

<nav class="gp-toc" aria-label="目次">
  <span class="gp-label block text-xs font-bold uppercase">Contents</span>
  <h2 class="gp-toc-title">目次</h2>
  <ol class="gp-toc-list">
    {
      chapters.map((chapter) => (
        <li class="gp-toc-item">
          <a href={`#${chapter.id}`} class="gp-toc-link">
            <span class="gp-toc-num">{chapter.num}</span>
            <span class="gp-toc-text">
              <span class="gp-toc-chapter-title">{chapter.title}</span>
              <span class="gp-toc-subtitle">{chapter.tocSubtitle}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>
