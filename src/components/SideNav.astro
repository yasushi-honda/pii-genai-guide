---
import { chapters } from '../data/chapters';
---

<nav class="gp-sidenav" aria-label="章ナビゲーション">
  <ol class="gp-sidenav-list">
    {
      chapters.map((chapter) => (
        <li>
          <a href={`#${chapter.id}`} class="gp-sidenav-link" data-chapter-id={chapter.id}>
            <span class="gp-sidenav-num">{chapter.num}</span>
            <span class="gp-sidenav-title">{chapter.title}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.gp-sidenav-link'));
  const targets = links
    .map((link) => {
      const id = link.dataset.chapterId;
      const el = id ? document.getElementById(id) : null;
      return el ? { link, el } : null;
    })
    .filter((t): t is { link: HTMLAnchorElement; el: HTMLElement } => t !== null);

  if (targets.length > 0) {
    const setActive = (id: string) => {
      for (const { link } of targets) {
        if (link.dataset.chapterId === id) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      }
    };

    // 複数の見出しが同時に交差判定の境界をまたぐ瞬間、コールバック引数の
    // 順序だけで決めると章の切り替わり際にアクティブ表示がちらつく。
    // その時点で交差中の全見出しから、画面上端に最も近いものを選ぶ。
    const intersecting = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            intersecting.add(entry.target.id);
          } else {
            intersecting.delete(entry.target.id);
          }
        }
        if (intersecting.size === 0) return;
        let closest: { id: string; top: number } | null = null;
        for (const { el } of targets) {
          if (!intersecting.has(el.id)) continue;
          const top = el.getBoundingClientRect().top;
          if (!closest || top < closest.top) closest = { id: el.id, top };
        }
        if (closest) setActive(closest.id);
      },
      { rootMargin: '0px 0px -80% 0px', threshold: 0 },
    );

    for (const { el } of targets) observer.observe(el);
  }
</script>
