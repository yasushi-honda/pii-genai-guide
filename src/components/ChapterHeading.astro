---
import { chapters } from '../data/chapters';

interface Props {
  id: string;
}

const { id } = Astro.props;
const chapter = chapters.find((c) => c.id === id);

if (!chapter) {
  throw new Error(`ChapterHeading: unknown chapter id "${id}"`);
}
---

<div class="gp-chapter-heading">
  <h2 id={chapter.id}>
    <span class="gp-label gp-chapter-kicker block text-xs font-bold uppercase">{chapter.kicker}</span>
    {chapter.title}
  </h2>
</div>
